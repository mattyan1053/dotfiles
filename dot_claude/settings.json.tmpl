{
  "model": "opus",
  "theme": "dark",
  "defaultMode": "auto",
  "skipAutoPermissionPrompt": true,
  "tui": "fullscreen",
  "agentPushNotifEnabled": true,
  "inputNeededNotifEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.dev)",
      "Read(**/.env.development)",
      "Read(**/.env.stg)",
      "Read(**/.env.staging)",
      "Read(**/.env.prod)",
      "Read(**/.env.production)",
      "Read(**/.env.test)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.crt)"
    ]
  }{{ if lookPath "codex" }},
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  }{{ end }}
}
