rgf() {
  rg "$1" --follow --line-number --no-heading |
  fzf --delimiter : --preview '
  file={1}
  line={2}
  half=$((FZF_PREVIEW_LINES / 2))
  start=$((line - half))
  (( start < 1 )) && start=1
  end=$((start + FZF_PREVIEW_LINES - 1))
  bat --style=numbers --color=always --line-range ${start}:${end} --highlight-line ${line} "$file"
  '
}
